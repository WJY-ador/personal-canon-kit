    },
    "windows-native": {
      "core": "미검증 — 코드 대응만",
      "optional": "로컬 에이전트: 미검증 — 자격 증명 저장소 미구현이라 연결·업로드 불가, 계약 검증·원문 보기만. 예약·알림 없음"
    },
    "windows-wsl": {
      "core": "미검증·미결정",
      "optional": "없음"
    }
  },
